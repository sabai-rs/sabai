[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
publish = false

# `main.rs` and tests call the app's code `bootstrap::...`, like Laravel's `bootstrap/app.php`,
# so it reads the same in every app whatever its name.
[lib]
name = "bootstrap"

[dependencies]
sabai = { {{sabai}}, features = ["orm", "auth"] }
serde = { version = "1", features = ["derive"] }

[dev-dependencies]
sabai-testing = { {{sabai-testing}}, features = ["orm"] }

# Keeps the app its own workspace, even inside another project's folder.
[workspace]

# Password hashing is slow on purpose, and unoptimized ten times slower, so `sabai serve` and
# tests stay fast in development. Add `argon2` here too with the `argon2` feature.
[profile.dev.package.blowfish]
opt-level = 3
