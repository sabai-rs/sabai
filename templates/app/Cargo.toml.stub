[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
publish = false

# `main.rs` and tests call the app's code `bootstrap::...`, like Laravel's `bootstrap/app.php`,
# so it reads the same in every app whatever its name.
[lib]
name = "bootstrap"

[dependencies]
sabai = { {{sabai}}, features = ["orm"] }
serde = { version = "1", features = ["derive"] }

[dev-dependencies]
sabai-testing = { {{sabai-testing}}, features = ["orm"] }

# Keeps the app its own workspace, even inside another project's folder.
[workspace]
